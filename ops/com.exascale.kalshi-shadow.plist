<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exascale.kalshi-shadow</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>/opt/homebrew/bin/uv run --directory /Users/michael/Kalshi python -m kalshi_data.operations.shadow_book &amp;&amp; /opt/homebrew/bin/uv run --directory /Users/michael/Kalshi python -m kalshi_data.operations.portfolio; /opt/homebrew/bin/uv run --directory /Users/michael/Kalshi python -m kalshi_data.operations.dashboard</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>20</integer></dict>
