<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exascale.kalshi-weekly</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>/opt/homebrew/bin/uv run --directory /Users/michael/Kalshi python -m kalshi_data.edge_health &amp;&amp; /opt/homebrew/bin/uv run --directory /Users/michael/Kalshi python -m kalshi_data.dashboard</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/michael/Kalshi/logs/weekly.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/michael/Kalshi/logs/weekly.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
